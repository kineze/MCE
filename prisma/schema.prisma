generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique @db.VarChar(320)
  passwordHash      String     @db.VarChar(512)
  displayName       String     @db.VarChar(160)
  status            UserStatus @default(ACTIVE)
  passwordChangedAt DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  roles             UserRole[] @relation("UserRoleUser")
  rolesAssigned     UserRole[] @relation("UserRoleAssignedBy")
  sessions          Session[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique @db.VarChar(120)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId       String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedById String?
  user         User     @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?    @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id         String    @id @default(uuid())
  tokenHash  String    @unique @db.VarChar(64)
  userId     String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?   @db.VarChar(45)
  userAgent  String?   @db.VarChar(512)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Venue {
  id        String             @id @default(uuid())
  slug      String             @unique @db.VarChar(80)
  name      String             @db.VarChar(160)
  address   String?            @db.VarChar(300)
  mapUrl    String?            @db.VarChar(500)
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  sessions  ProgrammeSession[]

  @@map("venues")
}

enum SessionKind {
  PERFORMANCE
  PANEL
  CONVERSATION
  WORKSHOP
  FILM
  COMMUNITY
  OTHER
}

/// A festival programme item. Not to be confused with `Session` (sign-in sessions).
model ProgrammeSession {
  id          String      @id @default(uuid())
  title       String      @db.VarChar(200)
  description String?     @db.VarChar(2000)
  kind        SessionKind @default(OTHER)
  venueId     String
  startsAt    DateTime
  endsAt      DateTime
  people      String?     @db.VarChar(500)
  moderator   String?     @db.VarChar(160)
  /// Prime-time evening performances, shown prominently on the public site.
  highlight   Boolean     @default(false)
  published   Boolean     @default(false)
  /// Internal planning notes. Never returned by public endpoints.
  notes       String?     @db.VarChar(2000)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  venue       Venue       @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@index([startsAt])
  @@index([venueId])
  @@index([published, startsAt])
  @@map("programme_sessions")
}

/// A visitor's festival registration. IP addresses are deliberately not stored.
model Registration {
  id                 String    @id @default(uuid())
  fullName           String    @db.VarChar(160)
  email              String    @unique @db.VarChar(320)
  phone              String?   @db.VarChar(40)
  country            String?   @db.VarChar(80)
  organisation       String?   @db.VarChar(160)
  /// Colombo dates ("2026-12-02") the visitor plans to attend.
  days               String[]
  /// Session kinds the visitor is interested in.
  interests          String[]
  wantsUpdates       Boolean   @default(false)
  consentedAt        DateTime
  /// When the thank-you email was accepted by Brevo; null until it has been sent.
  confirmationSentAt DateTime?
  /// Why the last attempt to send the thank-you email failed, if it did.
  confirmationError  String?   @db.VarChar(500)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([createdAt])
  @@map("registrations")
}
