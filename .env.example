# Prisma's migration engine does not fall back to the macOS user the way psql does,
# so name the PostgreSQL user explicitly (add :password if your setup requires one).
DATABASE_URL="postgresql://YOUR_USER@localhost:5432/mce?schema=public"

# Shown in the sidebar, login page and browser titles.
NUXT_PUBLIC_APP_NAME="MCE"

# Used once by `npm run admin:create`. Remove the password from the file afterwards.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# Thank-you emails for new registrations, sent through Brevo (https://www.brevo.com).
# API key: Brevo → SMTP & API → API keys. The sender must be verified in Brevo
# (Senders, Domains & Dedicated IPs). Leave the key empty to turn emails off.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="The MCE Festival"
# Optional: where replies go, e.g. the festival team's inbox.
BREVO_REPLY_TO=""

# Public address of the site (no trailing path). Emails use it for the logo and the
# programme link; without it they are sent as text-only designs with no links.
SITE_URL=""

# Set to true in production when the app listens only on localhost behind nginx, so rate
# limits use the visitor's address from X-Forwarded-For instead of the proxy's.
TRUST_PROXY=""
